{{!
    @template block_sqlreports/mobile_view_page

    Renders the configured report as a table in the Moodle Mobile app.

    Context variables required for this template:
    * title - Block title.
    * hasrows - Whether there are data rows.
    * headers - Array of { label } column headers.
    * rows - Array of { cells: [ { value } ] } data rows.
    * norows - "No data" message.
    * error - Non-empty when the report could not be displayed.
    * rowcount - Row-count label (empty when no rows).
    * fullurl - URL of the full report (empty when none).
    * viewfull - "View full report" link label.
}}
{{=<% %>=}}
<div padding>
    <%#error%>
        <ion-card>
            <ion-card-content><% error %></ion-card-content>
        </ion-card>
    <%/error%>
    <%^error%>
        <%#hasrows%>
            <div class="core-table-responsive">
                <table class="block_sqlreports-mobile-table">
                    <thead>
                        <tr>
                            <%#headers%><th><% label %></th><%/headers%>
                        </tr>
                    </thead>
                    <tbody>
                        <%#rows%>
                            <tr>
                                <%#cells%><td><% value %></td><%/cells%>
                            </tr>
                        <%/rows%>
                    </tbody>
                </table>
            </div>
        <%/hasrows%>
        <%^hasrows%>
            <core-empty-box icon="fas-table" message="<% norows %>"></core-empty-box>
        <%/hasrows%>
        <%#rowcount%>
            <ion-item lines="none">
                <ion-note slot="end"><% rowcount %></ion-note>
            </ion-item>
        <%/rowcount%>
        <%#fullurl%>
            <ion-item href="<% fullurl %>" core-link detail="true">
                <ion-label><% viewfull %></ion-label>
            </ion-item>
        <%/fullurl%>
    <%/error%>
</div>
